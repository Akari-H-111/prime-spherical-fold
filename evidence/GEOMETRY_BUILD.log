info: PrimeSphericalFoldAudit.lean:6:0: PrimeSphericalFold.complete_geometry :
  (ContMDiff PrimeSphericalFold.cylinderModel (modelWithCornersSelf ℝ (ℝ × ℝ × ℝ)) (↑⊤)
        PrimeSphericalFold.cylinderSurface ∧
      ∀ (p : PrimeSphericalFold.Cylinder), Function.Injective ⇑(mfderiv% PrimeSphericalFold.cylinderSurface p)) ∧
    (∀ (v : ℝ × ℝ × ℝ),
        (∃ a b, a ≠ b ∧ PrimeSphericalFold.cylinderSurface a = v ∧ PrimeSphericalFold.cylinderSurface b = v) ↔
          ∃ r, v = (0, ↑r, 0)) ∧
      (∀ (r : ↥PrimeSphericalFold.PositiveRadius) (p : PrimeSphericalFold.Cylinder),
          PrimeSphericalFold.cylinderSurface p = (0, ↑r, 0) ↔
            p = PrimeSphericalFold.positivePole r ∨ p = PrimeSphericalFold.negativePole r) ∧
        (∀ (a b : PrimeSphericalFold.Cylinder),
            a ≠ b →
              PrimeSphericalFold.cylinderSurface a = PrimeSphericalFold.cylinderSurface b →
                (↑(mfderiv% PrimeSphericalFold.cylinderSurface a)).range ⊔
                    (↑(mfderiv% PrimeSphericalFold.cylinderSurface b)).range =
                  ⊤) ∧
          (∀ (p : PrimeSphericalFold.Cylinder), PrimeSphericalFold.IsCritical p ↔ (↑p.2).im = 0) ∧
            (∀ (p : PrimeSphericalFold.Cylinder),
                PrimeSphericalFold.IsCritical p →
                  PrimeSphericalFold.HasWhitneyFoldAt PrimeSphericalFold.cylinderObservation p) ∧
              (ContMDiff (modelWithCornersSelf ℝ ℝ) (modelWithCornersSelf ℝ (ℝ × ℝ × ℝ)) (↑⊤)
                    PrimeSphericalFold.positiveDiagonal ∧
                  Topology.IsEmbedding PrimeSphericalFold.positiveDiagonal ∧
                    ∀ (t : ↥PrimeSphericalFold.PositiveRadius),
                      Function.Injective ⇑(mfderiv% PrimeSphericalFold.positiveDiagonal t)) ∧
                ∃ H,
                  ∀ (p : PrimeSphericalFold.Cylinder),
                    PrimeSphericalFold.cylinderObservation p = PrimeSphericalFold.standardFold ↑(H p)
